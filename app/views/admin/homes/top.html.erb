<div class="container mt-5">
  <h1 class="mb-4">管理者ダッシュボード</h1>

  <div class="row">
    
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h5 class="card-title">ユーザー数</h5>
          <p class="display-4"><%= @user_count %></p>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h5 class="card-title">タスク数</h5>
          <p class="display-4"><%= @task_count %></p>
        </div>
      </div>
    </div>
  </div>
</div>