<div class="container mt-5">
  <h1 class="mb-4">タスク管理</h1>

  <%= form_with url: admin_tasks_path, method: :get, class: "d-flex gap-2 mb-4" do |f| %>
    <%= f.text_field :q, placeholder: "タスクを検索", value: params[:q], class: "form-control w-25" %>
    <%= f.submit "検索", class: "btn btn-outline-secondary" %>
  <% end %>

  <table class="table table-hover">
    <thead>
      <tr>
        <th>内容</th>
        <th>投稿者</th>
        <th>難易度</th>
        <th>優先度</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
        <tr>
          <td><%= task.content %></td>
          <td><%= task.user.name %></td>
          <td><%= task.difficulty %></td>
          <td><%= task.priority %></td>
          <td><%= button_to "削除", admin_task_path(task),
                  method: :delete,
                  data: { turbo_confirm: "本当に削除しますか？" } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<div class="d-flex justify-content-center mb-3 ">
  <%= paginate @tasks %>
</div>
