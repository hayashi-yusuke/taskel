<h1>ユーザー管理</h1>

<%= form_with url: admin_users_path, method: :get do |f| %>
  <%= f.text_field :q, placeholder: "ユーザーを検索", value: params[:q] %>
  <%= f.submit "検索" %>
<% end %>

<% @users.each do |user| %>
  <div>
    <%= user.name %>
    <%= user.email_address %>
    <%= button_to "削除", admin_user_path(user), method: :delete %>
  </div>
<% end %>