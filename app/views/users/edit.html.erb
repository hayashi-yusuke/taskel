<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <h1>プロフィール編集</h1>

      <%= form_with model: @user do |f| %>
        <% if @user.errors.any? %>
          <div class="alert alert-danger">
            <ul>
              <% @user.errors.full_messages.each do |message| %>
                <li>
                  <%= message %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :name, "名前", class: "form-label" %>
          <%= f.text_field :name, class: "form-control mb-3" %>
        </div>

        <div>
          <%= f.label :email_address, "メールアドレス", class: "form-label" %>
          <%= f.email_field :email_address, class: "form-control mb-3" %>
        </div>

        <div>
          <%= f.label :password, "パスワード", class: "form-label" %>
          <%= f.password_field :password, class: "form-control mb-3" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "パスワード確認", class: "form-label" %>
          <%= f.password_field :password_confirmation, class: "form-control mb-5" %>
        </div>

          <%= f.submit "更新する", class: "btn btn-primary w-100" %>
          <%= button_to "退会", user_path(Current.user), method: :delete, data: { turbo_confirm: "本当に退会しますか?" }, class: "btn btn-danger w-100 mt-3" %>
        <% end %>
    </div>
  </div>
</div>