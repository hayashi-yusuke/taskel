<% content_for :sidebar do %>
  <%= render "shared/sidebar" %>
<% end %>

<h3 class="mb-3">マイタスク一覧</h3>

<% Current.user.tasks.where(completed: false).each do |task| %>
  <div class="card mb-3 task-card" id="task-<%= task.id %>">
    <div class="d-flex align-items-stretch"> 
      <%= button_to complete_task_path(task), method: :patch,
          class: "check-area border-0 bg-transparent",
          form_class: "check-area-form",
          data: { task_id: task.id } do %>
        <div class="check-circle" id="circle-<%= task.id %>"></div>
      <% end %>
      <div class="card-body">
        <p class="fw-bold mb-1"><%= link_to task.content, task_path(task) %></p>
        <p class="text-muted small mb-2">難易度 : <%= task.difficulty %> ／ 優先度 : <%= task.priority %></p>
        <div class="d-flex gap-2">
          <%= link_to "編集", edit_task_path(task), class: "btn btn-outline-secondary btn-sm" %>
          <%= button_to "削除", task_path(task), method: :delete, class: "btn btn-outline-danger btn-sm" %>
        </div>
      </div>
    </div>
  </div>
<% end %>
