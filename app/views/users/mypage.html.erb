<h1><%= Current.user.name %>のマイページ</h1>

<%= link_to "プロフィール編集", edit_user_path(Current.user) %>
<%= button_to "退会", user_path(Current.user), method: :delete, data: { turbo_confirm: "本当に退会しますか?" } %>

<%= form_with model: @task do |f| %>
  <%= f.label :content, "内容" %>
  <%= f.text_field :content %>

  <%= f.label :difficulty, "難易度" %>
  <% Task.difficulties.each_key do |level| %>
    <%= f.radio_button :difficulty, level, checked: level == "normal" %>
    <%= f.label "difficulty_#{level}", level %>
  <% end %>

  <%= f.label :priority, "優先度" %>
  <% Task.priorities.each_key do |level| %>
    <%= f.radio_button :priority, level, checked: level == "middle" %>
    <%= f.label "priority_#{level}", level %>
  <% end %>

  <%= f.submit "作成する" %>
<% end %>

<h2>タスク一覧</h2>

<% Current.user.tasks.where(completed: false).each do |task| %>
  <p><%= task.content %></p>
  <p>難易度 : <%= task.difficulty %></p>
  <p>優先度 : <%= task.priority %></p>
  <%= button_to "完了にする✅", complete_task_path(task), method: :patch %>
  <p><%= link_to "編集", edit_task_path(task) %></p>
  <p><%= button_to "削除", task_path(task), method: :delete %></p>
<% end %>