<% content_for :sidebar do %>
  <%= render "shared/sidebar" %>
<% end %>

<div class="card mb-4">
  <div class="card-body">
    <div class="d-flex align-items-center gap-3">
      <div style="width: 60px; height: 60px; border-radius: 50%; background: #b5d4f4;"></div>
      <div>
        <h3 class="mb-0"><%= @user.name %>のプロフィール</h3>
        <div class="d-flex gap-3 mt-1">
          <%= link_to followings_user_path(@user), class: "small text-decoration-none text-dark" do %>
            フォロー <strong><%= @user.followings.count %></strong>
          <% end %>
          <%= link_to followers_user_path(@user), class: "small text-decoration-none text-dark" do %>
            フォロワー <strong><%= @user.followers.count %></strong>
          <% end %>
        </div>
      </div>
      <%= render "follows/follow_button",user: @user %>
    </div>
  </div>
</div>

<ul class="nav nav-tabs mb-3">
  <li class="nav-item">
    <%= link_to "未完了", user_path(@user, tab: "incomplete"),
      class: "nav-link #{params[:tab] != 'completed' ? 'active' : ''}" %>
  </li>
  <li class="nav-item">
    <%= link_to "完了済み", user_path(@user, tab: "completed"),
      class: "nav-link #{params[:tab] == 'completed' ? 'active' : ''}" %>
  </li>
</ul>
<% @tasks.each do |task| %>
  <div class="card mb-3 <%= 'bg-light' if task.completed %>">
    <div class="card-body">
      <p class="fw-bold mb-1 <%= 'text-decoration-line-through text-muted' if task.completed %>"> <%= link_to task.content, task_path(task) %></p>
      <p class="text-muted small mb-0">難易度: <%= task.difficulty %> ／ 優先度: <%= task.priority %></p>
    </div>
  </div>
<% end %>
<div class="d-flex justify-content-center mb-3 ">
  <%= paginate @tasks %>
</div>