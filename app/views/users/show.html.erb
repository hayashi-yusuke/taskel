<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card mb-4">
        <div class="card-body">
          <div class="d-flex align-items-center gap-3">
            <div style="width: 60px; height: 60px; border-radius: 50%; background: #b5d4f4;"></div>
            <h3 class="mb-0"><%= @user.name %>のプロフィール</h3>
            <%= render "follows/follow_button",user: @user %>
          </div>
        </div>
      </div>

      <h5 class="mb-3">タスク一覧</h5>
      <% @tasks.each do |task| %>
        <div class="card mb-3">
          <div class="card-body">
            <p class="fw-bold mb-1"><%= task.content %></p>
            <p class="text-muted small mb-0">難易度: <%= task.difficulty %> ／ 優先度: <%= task.priority %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>