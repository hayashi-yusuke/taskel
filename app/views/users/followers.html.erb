<% content_for :sidebar do %>
  <%= render "shared/sidebar" %>
<% end %>

<h3 class="mb-4"><%= @user.name %>のフォロワー一覧</h3>

<% if @users.empty? %>
  <p class="text-muted">まだフォロワーがいません</p>
<% else %>
  <% @users.each do |user| %>
    <div class="card mb-3">
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <%= link_to user.name, user_path(user), class: "fw-bold" %>
          <p class="text-muted small mb-0">タスク数: <%= user.tasks.count %></p>
        </div>
        <%= render "follows/follow_button", user: user %>
      </div>
    </div>
  <% end %>
<% end %>