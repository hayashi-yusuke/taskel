<% content_for :sidebar do %>
  <%= render "shared/sidebar" %>
<% end %>

<% if params[:user_q].present? %>
  <h3 class="mb-4">ユーザー検索結果</h3>
  <% if @users.empty? %>
    <p class="text-muted">一致するユーザーは見つかりませんでした</p>
  <% else %>
    <% @users.each do |user| %>
      <div class="card mb-3">
        <div class="card-body">
          <%= link_to user.name, user_path(user) %>
          <%= render "follows/follow_button", user: user %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
