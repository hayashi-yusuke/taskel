<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      
      <h1 class="text-center mb-4">新規登録</h1>

      <%= form_with model: @user do |f| %>
        <% if @user.errors.any? %>
          <div class="alert alert-danger">
            <ul>
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="mb-3">
          <%= f.label :name, "名前", class: "form-label" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :email_address, "メールアドレス", class: "form-label" %>
          <%= f.email_field :email_address, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :password, "パスワード", class: "form-label" %>
          <%= f.password_field :password, class: "form-control" %>
        </div>

        <div class="mb-5">
          <%= f.label :password_confirmation, "パスワード確認", class: "form-label" %>
          <%= f.password_field :password_confirmation, class: "form-control" %>
        </div>

          <%= f.submit "登録する", class: "btn btn-primary w-100 mb-3" %>
        <% end %>

      <%= link_to "ログインはこちら", new_session_path, class: "d-block text-center" %>
    </div>
  </div>
</div>