<!DOCTYPE html>
<html>
  <head>
    <title>Taskel Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header>
      <nav class="navbar navbar-dark bg-dark">
        <div class="container d-flex justify-content-between align-items-center">
          <%= link_to "Taskel 管理画面", admin_top_path, class: "navbar-brand text-white" %>
          <div class="d-flex align-items-center">
            <%= link_to "ユーザー管理", admin_users_path, class: "nav-link text-white me-3" %>
            <%= link_to "タスク管理", admin_tasks_path, class: "nav-link text-white me-3" %>
            <%= button_to "ログアウト", admin_session_path, method: :delete, class: "btn btn-outline-light" %>
          </div>
        </div>
      </nav>
    </header>

    <%= render "shared/flash" %>

    <%= yield %>
  </body>
</html>