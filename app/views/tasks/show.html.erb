<% content_for :sidebar do %>
  <%= render "shared/sidebar" %>
<% end %>
      
<div class="card mb-4 <%= 'bg-light' if @task.completed %>">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h4 class="card-title <%= 'text-decoration-line-through text-muted' if @task.completed %>">
          <%= @task.content %>
        </h4>
        <p class="text-muted small"><%= @task.difficulty %> / <%= @task.priority %></p>
        <p class="text-muted small"><%= @task.created_at.strftime("%Y年%m月%d日 %H:%M") %></p>
      </div>
      <div class="d-flex flex-column align-items-end gap-1">
        <%= render "likes/like_button", task: @task %>
        <span class="text-muted small ms-2">💬 <%= @task.comments.count %></span>
      </div>
    </div>
  </div>
</div>

<h5 class="mb-4">コメント</h5>
<div class="card mb-4">
  <div class="card-body">
    <h6 class="card-title">コメントを投稿</h6>
    <%= form_with model: [@task, @comment] do |f| %>
      <div class="mb-3">
        <%= f.text_field :content, placeholder: "コメントを入力", class: "form-control" %>
      </div>
      <%= f.submit "投稿する", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>

<div class="card mb-4">
  <ul class="list-group list-group-flush">
    <% @task.comments.each do |comment| %>
      <li class="list-group-item">
        <%= link_to comment.user.name, user_path(comment.user), class: "fw-bold mb-1" %>
        <p class="mb-1"><%= comment.content %></p>
        <p class="text-muted small"><%= comment.created_at.strftime("%Y年%m月%d日 %H:%M") %></p>
        <% if comment.user_id == Current.user.id %>
          <%= button_to "削除",task_comment_path(@task, comment),
          method: :delete,
          class: "btn btn-outline-danger btn-sm",
          data: { turbo_confirm: "本当に削除しますか？" } %>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
