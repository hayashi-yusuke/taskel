<div class="container mt-5">
  <h3 class="mb-4">タスク一覧</h3>

  <% @tasks.each do |task| %>
    <div class="card mb-3">
      <div class="card-body">
        <p class="fw-bold mb-1"> <%= task.content %></p>
        <p class="text-muted small mb-2">難易度: <%= task.difficulty %> ／ 優先度: <%= task.priority %></p>
        <%= link_to task.user.name, user_path(task.user), class: "small" %>
      </div>
    </div>
  <% end %>
</div>